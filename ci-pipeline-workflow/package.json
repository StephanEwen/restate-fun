{
  "name": "restate-ts-template",
  "version": "0.0.1",
  "description": "Template for JavaScript/TypeScript services running with Restate (https://github.com/restatedev/) ",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmitOnError",
    "start": "node ./dist/app.js",
    "dev": "tsx watch ./src/app.ts",
    "register": "restate deployments register http://localhost:9081"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.13.0",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
